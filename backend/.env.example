# Django
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=replace-with-a-random-value-of-at-least-32-bytes

# PostgreSQL (obligatoria en produccion)
DATABASE_URL=postgresql://user:password@host:5432/database

# Railway / HTTP
ALLOWED_HOSTS=api.example.edu.co
CORS_ALLOWED_ORIGINS=https://app.example.edu.co
CSRF_TRUSTED_ORIGINS=https://app.example.edu.co
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Autenticacion e integracion
MASTER_KEY=
ILINYX_API_KEY=replace-with-a-random-service-key
FRONTEND_URL=https://app.example.edu.co
GOOGLE_OAUTH_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_ALLOWED_DOMAIN=upn.edu.co

# Correo
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.edu.co

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
